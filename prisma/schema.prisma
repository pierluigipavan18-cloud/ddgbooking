generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("admin") // admin | agent
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  agents        Agent[]
  bookingLinks  BookingLink[]
  contacts      Contact[]
  emailSequences EmailSequence[]
  settings      UserSettings?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Booking ────────────────────────────────────────────────────────────

model Agent {
  id          String   @id @default(cuid())
  userId      String
  name        String
  email       String
  title       String?  // e.g. "Consulente Energia"
  avatar      String?
  color       String   @default("#0066FF")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Google Calendar integration
  googleCalendarId    String?
  googleRefreshToken  String?

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability      Availability[]
  bookings          Booking[]
  bookingLinkAgents BookingLinkAgent[]
}

model BookingLink {
  id          String   @id @default(cuid())
  userId      String
  slug        String   @unique
  title       String
  description String?
  duration    Int      @default(30) // minutes
  isActive    Boolean  @default(true)
  theme       String   @default("default") // default | ocean | sunset | forest | midnight
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingLinkAgents BookingLinkAgent[]
  bookings          Booking[]
}

model BookingLinkAgent {
  id            String @id @default(cuid())
  bookingLinkId String
  agentId       String
  priority      Int    @default(0) // lower = higher priority

  bookingLink BookingLink @relation(fields: [bookingLinkId], references: [id], onDelete: Cascade)
  agent       Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([bookingLinkId, agentId])
}

model Availability {
  id        String @id @default(cuid())
  agentId   String
  dayOfWeek Int    // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime String // "09:00"
  endTime   String // "17:00"

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Booking {
  id              String   @id @default(cuid())
  bookingLinkId   String
  agentId         String
  contactId       String?
  startTime       DateTime
  endTime         DateTime
  status          String   @default("confirmed") // confirmed | cancelled | completed | no_show
  meetLink        String?
  googleEventId   String?
  notes           String?
  privacyConsent  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Guest info (also stored in Contact)
  guestName       String
  guestEmail      String
  guestPhone      String?
  guestCompany    String?

  bookingLink     BookingLink @relation(fields: [bookingLinkId], references: [id], onDelete: Cascade)
  agent           Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  contact         Contact?    @relation(fields: [contactId], references: [id])
}

// ─── CRM ─────────────────────────────────────────────────────────────────────

model Contact {
  id             String   @id @default(cuid())
  userId         String
  name           String
  email          String
  phone          String?
  company        String?
  stage          String   @default("lead") // lead | prospect | customer | churned
  source         String?  // booking | manual | api
  notes          String?
  tags           String?  // comma-separated
  privacyConsent Boolean  @default(false)
  consentDate    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  activities     Activity[]
}

model Activity {
  id        String   @id @default(cuid())
  contactId String
  type      String   // note | email_sent | booking_created | booking_completed | call | status_change
  content   String
  metadata  String?  // JSON string for extra data
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

// ─── Email Sequences ─────────────────────────────────────────────────────────

model EmailSequence {
  id        String   @id @default(cuid())
  userId    String
  name      String
  trigger   String   // booking_created | booking_reminder | booking_completed
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails EmailTemplate[]
}

model EmailTemplate {
  id              String @id @default(cuid())
  emailSequenceId String
  subject         String
  body            String
  delayMinutes    Int    @default(0) // delay after trigger
  order           Int    @default(0)

  emailSequence EmailSequence @relation(fields: [emailSequenceId], references: [id], onDelete: Cascade)
}

model EmailLog {
  id         String   @id @default(cuid())
  to         String
  subject    String
  status     String   @default("pending") // pending | sent | failed
  sentAt     DateTime?
  error      String?
  createdAt  DateTime @default(now())
}

// ─── Settings ────────────────────────────────────────────────────────────────

model UserSettings {
  id               String  @id @default(cuid())
  userId           String  @unique
  companyName      String  @default("ddgBooking")
  timezone         String  @default("Europe/Rome")
  language         String  @default("it")
  brandColor       String  @default("#0066FF")
  logoUrl          String?
  privacyPolicyUrl String?
  customCss        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
