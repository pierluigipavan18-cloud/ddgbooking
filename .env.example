# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ddgbooking"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Google OAuth (for login + Calendar + Meet)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Resend (transactional emails — https://resend.com)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="ddgBooking <noreply@ddg.solutions>"

# Allowed admin emails (comma-separated — only these can sign in)
ALLOWED_ADMIN_EMAILS="diego@ddg.solutions"

# App (production: https://ddgbooking.it)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ddgBooking"
