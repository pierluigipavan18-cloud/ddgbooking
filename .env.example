# Database — Railway provides this automatically when you add a PostgreSQL service
# Link it via: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="https://your-app.up.railway.app"

# Resend (transactional emails — https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="ddgBooking <noreply@ddg.solutions>"

# App
NEXT_PUBLIC_APP_URL="https://your-app.up.railway.app"
NEXT_PUBLIC_APP_NAME="ddgBooking"
